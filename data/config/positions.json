{
  "schemaVersion": 1,
  "datasetId": "basket-legends-nba-positions-v1",
  "status": "validated-design-specification",
  "sport": "basketball",
  "leagueReference": "NBA",
  "description": "Référentiel de conception des cinq postes de Basket Legends. Les postes décrivent des rôles de jeu et ne constituent pas des conditions d'éligibilité.",
  "system": {
    "positionCount": 5,
    "positions": [
      "PG",
      "SG",
      "SF",
      "PF",
      "C"
    ],
    "primaryPositionRequired": true,
    "secondaryPositionsAllowed": true,
    "secondaryPositionsMax": 4,
    "eligibilityRestrictions": false
  },
  "positionAptitude": {
    "scale": {
      "min": 0,
      "max": 100
    },
    "oneScorePerPosition": true,
    "calculation": {
      "method": "weighted_position_attributes_with_individual_factors",
      "components": {
        "weightedAttributes": 0.75,
        "positionExperience": 0.15,
        "training": 0.05,
        "development": 0.05
      },
      "attributeWeightsMustSumTo": 1,
      "factorScale": [
        0,
        100
      ],
      "rounding": "nearest_integer",
      "clampToScale": true,
      "missingAttributePolicy": "renormalize_available_attribute_weights_and_reduce_confidence",
      "experiencePolicy": "derive_from_documented_position_history_or_simulated_career_history",
      "trainingPolicy": "use_player_specific_training_history",
      "developmentPolicy": "use_individual_development_state_not_potential_as_a_substitute"
    }
  },
  "archetypes": {
    "independentFromPosition": true,
    "definedSeparately": true,
    "positionDeterminesArchetype": false,
    "examples": [
      "Sharpshooter",
      "Rim Protector",
      "3-and-D",
      "Slasher",
      "Playmaking Big",
      "Stretch Big",
      "Two-Way Wing",
      "Post Scorer"
    ]
  },
  "aging": {
    "mode": "individual",
    "positionCurvesAre": "statistical_reference_only",
    "playerSpecificFactors": [
      "age",
      "minutes_and_career_workload",
      "physical_profile",
      "injury_history",
      "training",
      "recovery",
      "individual_attributes"
    ],
    "retirementIsForcedByPositionAge": false,
    "declineIsDeterministicByPosition": false
  },
  "physicalTemplates": {
    "unitSystem": "metric",
    "role": "descriptive_reference_not_eligibility_requirement",
    "heightCm": "inclusive_range",
    "weightKg": "inclusive_range"
  },
  "injuryModel": {
    "method": "probabilistic",
    "positionExposureIs": "risk_modifier_not_guarantee",
    "injuryHistoryAndIndividualLoadMustBeConsidered": true
  },
  "sourcePositionMapping": {
    "preserveOriginalSourcePosition": true,
    "assignSecondaryPositionsAutomatically": false,
    "mappingRequiresPlayerLevelEvidence": true,
    "note": "Les anciennes valeurs source (G, F, C et combinaisons) sont conservées. Leur conversion en poste principal ou secondaire NBA doit être arbitrée joueur par joueur à partir des données disponibles."
  },
