{
  "name": "basket-legends",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @basket-legends/web",
    "build": "npm run build -w @basket-legends/web",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verifier": "tsx tools/verifier-donnees.ts",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run verifier && npm run build && npm run parcours",
    "sonde": "tsx tools/sonde-match.ts",
    "parcours": "playwright test",
    "notes": "tsx tools/calculer-notes.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
